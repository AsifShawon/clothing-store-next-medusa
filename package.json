{
  "name": "london-boy-dtc-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.11.1",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:unit": "turbo test:unit --filter=@dtc/backend",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "demo:dev": "turbo dev --filter=@dtc/portfolio-demo",
    "demo:build": "turbo build --filter=@dtc/portfolio-demo",
    "demo:lint": "turbo lint --filter=@dtc/portfolio-demo",
    "demo:test": "turbo test --filter=@dtc/portfolio-demo",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:shared-ui": "node scripts/check-shared-ui.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "type-check": "turbo type-check"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
