# Medusa Backend Environment Variables

# PostgreSQL database connection string (from docker-compose or local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-backend

# Redis connection string for caching and event bus
REDIS_URL=redis://localhost:6379

# CORS configurations
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173

# Security secrets for JWT token signing and session cookies (replace with secure random strings in production)
JWT_SECRET=supersecret_dev_jwt_secret_key_32bytes
COOKIE_SECRET=supersecret_dev_cookie_secret_key_32bytes

# Backend URL
MEDUSA_BACKEND_URL=http://localhost:9000
