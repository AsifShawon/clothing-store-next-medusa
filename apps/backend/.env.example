# ==============================================================================
# MEDUSA BACKEND DEVELOPMENT ENVIRONMENT DEFAULTS
# ==============================================================================
# Safe local defaults for rapid development with local PostgreSQL & Redis.
# In production, consult .env.template and configure strong, unique secrets.
# ==============================================================================

NODE_ENV=development
PORT=9000

# Local PostgreSQL database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-backend

# Local Redis connection string
REDIS_URL=redis://localhost:6379

# Local Development CORS configurations
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173

# Development-only secrets (32+ chars; never use in production)
JWT_SECRET=supersecret_dev_jwt_secret_key_32bytes
COOKIE_SECRET=supersecret_dev_cookie_secret_key_32bytes

# Backend URL & Storefront URL
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# Stripe Payment Provider (Optional in local development; pp_system_default is available)
# STRIPE_API_KEY=your_test_api_key
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CAPTURE=true

# Object Storage (Optional in dev; falls back to @medusajs/medusa/file-local)
# S3_URL=http://localhost:9000/static
# S3_BUCKET=local-development
# S3_REGION=auto
# S3_ACCESS_KEY_ID=dev_access_key
# S3_SECRET_ACCESS_KEY=dev_secret_key

# Transactional Email (Optional in dev; logs emails cleanly to console)
# RESEND_API_KEY=re_dev_test_key
RESEND_FROM_EMAIL=London Boy <orders@send.londonboy.co.uk>
RESEND_REPLY_TO=support@londonboy.co.uk
DISABLE_EMAIL_NOTIFICATIONS=false
