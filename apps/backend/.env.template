# ==============================================================================
# MEDUSA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.production and provide real values before starting.
# NEVER commit .env files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME (Mandatory, Server-Only)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=9000

# PostgreSQL connection string
# Development example: postgres://postgres:postgres@localhost:5432/medusa-backend
# Production example:  postgres://medusa_user:<PASSWORD>@postgres:5432/medusa_prod
DATABASE_URL=postgres://medusa_user:CHANGE_ME_GENERATE_SECURE_PASSWORD@postgres:5432/medusa_prod

# Redis connection string for caching and distributed event bus
# Development example: redis://localhost:6379
# Production example:  redis://default:<PASSWORD>@redis:6379 or rediss://...
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 2. SECURITY & SECRETS (Mandatory in Production, Server-Only)
# Minimum 32 characters, high entropy. DO NOT USE 'supersecret' or placeholders.
# Generate via: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_JWT_SECRET
COOKIE_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_COOKIE_SECRET

# ------------------------------------------------------------------------------
# 3. HTTP & CORS ORIGINS (Mandatory in Production, Server-Only)
# Comma-separated list of exact allowed browser origins (no paths, no trailing slash).
# In production, do NOT include documentation domains like docs.medusajs.com.
# ------------------------------------------------------------------------------
# Storefront origins that make customer-facing store API requests
# Development: http://localhost:8000
# Production:  https://londonboy.co.uk,https://www.londonboy.co.uk
STORE_CORS=https://londonboy.co.uk,https://www.londonboy.co.uk

# Admin origins allowed to access the Medusa Admin API (/admin/*)
# Development: http://localhost:9000,http://localhost:5173
# Production:  https://admin.londonboy.co.uk,https://api.londonboy.co.uk
ADMIN_CORS=https://admin.londonboy.co.uk,https://api.londonboy.co.uk

# Authentication origins allowed to initiate auth callbacks (/auth/*)
# Development: http://localhost:9000,http://localhost:8000,http://localhost:5173
# Production:  https://londonboy.co.uk,https://admin.londonboy.co.uk,https://api.londonboy.co.uk
AUTH_CORS=https://londonboy.co.uk,https://admin.londonboy.co.uk,https://api.londonboy.co.uk

# Backend external URL
# Development: http://localhost:9000
# Production:  https://api.londonboy.co.uk
MEDUSA_BACKEND_URL=https://api.londonboy.co.uk

# Storefront URL for transactional email links (password resets, order confirmation)
# Development: http://localhost:8000
# Production:  https://londonboy.co.uk
STOREFRONT_URL=https://londonboy.co.uk

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Mandatory in Production, Cloudflare R2 / AWS S3 Compatible)
# In production, silent local storage fallback is prohibited to prevent container data loss.
# ------------------------------------------------------------------------------
S3_URL=https://media.londonboy.co.uk
S3_BUCKET=londonboy-media
S3_REGION=auto
S3_ENDPOINT=https://CHANGE_ME_CF_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT PROVIDER (Atomic: Both Key and Webhook Secret Required if Enabled)
# In production: configure live Stripe API and webhook signing keys.
# Immediate capture is default (STRIPE_CAPTURE=true) for DTC clothing checkout.
# Set STRIPE_CAPTURE=false to authorize on checkout and capture upon order fulfillment.
# ------------------------------------------------------------------------------
STRIPE_API_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_CAPTURE=true

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend Provider)
# Consumed by apps/backend/src/modules/email-notifications for order & auth emails.
# Set DISABLE_EMAIL_NOTIFICATIONS=true if emails are intentionally handled off-server.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=London Boy <orders@send.londonboy.co.uk>
RESEND_REPLY_TO=support@londonboy.co.uk
DISABLE_EMAIL_NOTIFICATIONS=false
