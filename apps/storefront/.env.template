# ==============================================================================
# STOREFRONT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or configure in your deployment platform.
# Client-side variables (prefixed with NEXT_PUBLIC_) are exposed to the browser.
# ==============================================================================

NODE_ENV=production

# Medusa Backend API URL
# Development: http://localhost:9000
# Production:  https://api.londonboy.co.uk
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.londonboy.co.uk

# Storefront Public Base URL
# Development: http://localhost:8000
# Production:  https://londonboy.co.uk
NEXT_PUBLIC_BASE_URL=https://londonboy.co.uk

# Default region code for storefront localization (e.g. bd, uk, us)
NEXT_PUBLIC_DEFAULT_REGION=bd

# Medusa Storefront Publishable API Key (Mandatory: obtain from Medusa Admin or initial seed)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME_MEDUSA_PUBLISHABLE_KEY

# Stripe Publishable Key (Mandatory in production when Stripe checkout is enabled)
# Development: pk_test_...
# Production:  pk_live_...
NEXT_PUBLIC_STRIPE_KEY=pk_live_CHANGE_ME_STRIPE_PUBLISHABLE_KEY

# ==============================================================================
# SERVER-ONLY VARIABLES (Never exposed to browser bundle)
# ==============================================================================

# Shared secret for on-demand Next.js cache revalidation webhook (/api/revalidate)
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_REVALIDATE_SECRET

# Optional: Server-side internal backend URL (e.g. docker bridge network http://backend:9000)
# MEDUSA_BACKEND_URL=http://backend:9000
