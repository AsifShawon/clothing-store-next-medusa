# Next.js Storefront Environment Variables

# Publishable API key from Medusa backend (generated after backend:seed or via Admin Dashboard / API)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Base URL of the storefront application
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region code for localization (e.g. dk, us, gb, de)
NEXT_PUBLIC_DEFAULT_REGION=bd

# Stripe publishable key (optional, for card payments)
NEXT_PUBLIC_STRIPE_KEY=

# Node environment
NODE_ENV=development
