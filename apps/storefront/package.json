{
  "name": "@dtc/storefront",
  "version": "1.0.3",
  "private": true,
  "author": "London Boy DTC Team",
  "description": "London Boy DTC Clothing Store Next.js Storefront",
  "keywords": [
    "clothing-store",
    "ecommerce",
    "medusa-storefront",
    "london-boy"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "next lint",
    "test": "pnpm run test:unit",
    "test:unit": "node -e \"const path = require('path'); const { createJiti } = require('jiti'); const jiti = createJiti(path.resolve('package.json')); jiti('./tests/unit/env-validation.test.ts'); jiti('./tests/unit/adapters.test.ts'); jiti('./tests/unit/revalidate.test.ts');\"",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@dtc/commerce-contracts": "workspace:*",
    "@dtc/storefront-ui": "workspace:*",
    "@headlessui/react": "^2.2.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/ui-preset": "2.19.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "next": "15.5.21",
    "qs": "^6.12.1",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.5",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@medusajs/types": "2.19.0",
    "@playwright/test": "^1.62.1",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.19.0",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@types/react-instantsearch-dom": "^6.12.3",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.3.2"
  }
}
